# ─── Database ───────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── JWT Secrets (generate with: openssl rand -hex 32) ───
JWT_ACCESS_SECRET=change_me_to_a_random_64_character_hex_string
JWT_REFRESH_SECRET=change_me_to_a_random_64_character_hex_string
JWT_MFA_PENDING_SECRET=change_me_to_a_random_64_character_hex_string
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL_DAYS=7

# ─── MFA Encryption (AES-256-GCM, 32 bytes = 64 hex chars) ──
MFA_ENCRYPTION_KEY=change_me_to_a_random_64_character_hex_string

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── CAPTCHA ────────────────────────────────────────────────
CAPTCHA_ENABLED=false

# ─── IP Allow-List (comma-separated IPs or CIDR ranges) ────
IP_ALLOW_LIST=127.0.0.1,::1

# ─── PayPal (Sandbox) ──────────────────────────────────────
PAYPAL_CLIENT_ID=sb
PAYPAL_CLIENT_SECRET=sb
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# ─── WebAuthn / Passkeys ───────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ─── Email Alerts (optional) ───────────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=alerts@timebank.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Node Environment ──────────────────────────────────────
NODE_ENV=development
PORT=4000

